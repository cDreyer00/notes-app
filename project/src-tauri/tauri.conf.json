{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notes",
  "identifier": "com.cris.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Notes",
        "width": 560,
        "height": 460,
        "minWidth": 420,
        "minHeight": 320,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "theme": "Dark"
      },
      {
        "label": "settings",
        "title": "Notes — Configurações",
        "url": "settings.html",
        "width": 540,
        "height": 520,
        "resizable": false,
        "center": true,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
